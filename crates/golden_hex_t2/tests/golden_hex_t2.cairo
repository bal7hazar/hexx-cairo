#[test]
#[available_gas(l2_gas: 26334)]
fn golden_hex_diagonal_neighbor_coord() {
    let all = VertexDirectionTrait::ALL_DIRECTIONS;
    let direction = *all.span().at(0);
    assert(
        HexTrait::diagonal_neighbor_coord(direction) == HexTrait::new(2, -1),
        'diagonal_neighbor_coord 0',
    );
    let all = VertexDirectionTrait::ALL_DIRECTIONS;
    let direction = *all.span().at(1);
    assert(
        HexTrait::diagonal_neighbor_coord(direction) == HexTrait::new(1, 1),
        'diagonal_neighbor_coord 1',
    );
    let all = VertexDirectionTrait::ALL_DIRECTIONS;
    let direction = *all.span().at(2);
    assert(
        HexTrait::diagonal_neighbor_coord(direction) == HexTrait::new(-1, 2),
        'diagonal_neighbor_coord 2',
    );
    let all = VertexDirectionTrait::ALL_DIRECTIONS;
    let direction = *all.span().at(3);
    assert(
        HexTrait::diagonal_neighbor_coord(direction) == HexTrait::new(-2, 1),
        'diagonal_neighbor_coord 3',
    );
    let all = VertexDirectionTrait::ALL_DIRECTIONS;
    let direction = *all.span().at(4);
    assert(
        HexTrait::diagonal_neighbor_coord(direction) == HexTrait::new(-1, -1),
        'diagonal_neighbor_coord 4',
    );
    let all = VertexDirectionTrait::ALL_DIRECTIONS;
    let direction = *all.span().at(5);
    assert(
        HexTrait::diagonal_neighbor_coord(direction) == HexTrait::new(1, -2),
        'diagonal_neighbor_coord 5',
    );
}

