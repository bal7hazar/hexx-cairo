        (-6, 8, 0, 1, 2, 3, 4, 5), (-29, -7, 0, 1, 2, 3, 4, 5), (29, 24, 0, 1, 2, 3, 4, 5),
        (-14, -10, 0, 1, 2, 3, 4, 5), (12, 36, 0, 1, 2, 3, 4, 5), (33, -30, 0, 1, 2, 3, 4, 5),
        (-19, -17, 0, 1, 2, 3, 4, 5), (-20, -1, 0, 1, 2, 3, 4, 5),
    ];
    let mut i = 0;
    while i < cases.len() {
        let (x, y, i0, i1, i2, i3, i4, i5) = *cases.at(i);
        let h = HexTrait::new(x, y);
        let edges = h.all_edges().span();
        let expected = array![i0, i1, i2, i3, i4, i5].span();
        let mut k = 0;
        while k < 6 {
            let e = *edges.at(k);
            assert(e.origin == h && e.direction.index() == *expected.at(k), 'all_edges');
            k += 1;
        }
        i += 1;
    }
}

