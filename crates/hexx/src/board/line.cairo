    (0x1000400040010000, 15, 28, 15, 28), (0x2000400080010000, 15, 27, 15, 27),
    (0x4000800080010000, 15, 26, 15, 26), (0x8001000180010000, 15, 25, 15, 25), (0x0, 30, 0, 30, 0),
    (0x0, 30, 0, 30, 0), (0x0, 30, 0, 30, 0), (0x0, 30, 0, 30, 0), (0x0, 30, 0, 30, 0),
    (0x0, 30, 0, 30, 0), (0x0, 30, 0, 30, 0), (0x2000400100020008000, 18, 29, 18, 29),
    (0x4000800100020008000, 17, 29, 17, 29), (0x8000800200040008000, 16, 29, 16, 29),
    (0x8001000200040008000, 15, 29, 15, 29), (0x10002000400040010000, 15, 28, 15, 28),
    (0x20002000400080010000, 15, 27, 15, 27), (0x40004000800080010000, 15, 26, 15, 26),
];

// endregion

/// One step of the loop path on the board: the position as a bit, its column and the parity of
/// its row.
#[derive(Copy, Drop)]
struct Cursor {
    bit: felt252,
    column: u8,
    odd: bool,
}

/// The constants of the loop path: the last column and the six shifts of a step off the row.
#[derive(Copy, Drop)]
struct Shifts {
    /// `W − 1`.
    last: u8,
    /// `2^(W−1)`, `2^W`, `2^(W+1)`: one row up.
    up_narrow: felt252,
    up: felt252,
    up_wide: felt252,
    /// `2^-(W−1)`, `2^-W`, `2^-(W+1)`: one row down.
    down_narrow: felt252,
    down: felt252,
    down_wide: felt252,
}

#[generate_trait]
pub impl LineImpl of LineTrait {
    /// The tiles strictly between two tiles of the board.
    /// # Arguments
    /// * `self` - The map, any dimensions of the engine
    /// * `from` - The first position, ring tiles included
    /// * `to` - The second position, ring tiles included
    /// # Returns
    /// * `Some` of the bitmap of the tiles of the line between `index_to_hex(from)` and
    ///   `index_to_hex(to)` (`HexTrait::line_to`), both ends excluded (`Some(0)` when they are
    ///   equal or adjacent); `None` when one of those tiles lies outside the board. Symmetric:
    ///   `line(a, b) == line(b, a)`
    /// # Panics
    /// * `'Asserter: position not inside'` if a position is outside the board (`>= W * H`)
    ///
    /// Mirrors nothing in `hexx`: an extension (plan §6.6, N-5).
    fn line(self: HexMap, from: u8, to: u8) -> Option<felt252> {
        // [Check] Both positions inside the board
        LineAssert::assert_inside(self.width, self.height, from, to);
        // [Compute] The table path: the width 15, a distance of at most 6
        if self.width == TABLE_WIDTH {
            if let Some(line) = LineInternal::table(from, to) {
                return line;
            }
        }
        // [Compute] The loop path
        LineInternal::walk(self.width, from, to)
    }

    /// Whether walls block the sight between two tiles: walls block, actors do not, the ends are
    /// not tested (D-24).
    /// # Arguments
    /// * `self` - The map, `1` is walkable
    /// * `from` - The first position
    /// * `to` - The second position
    /// # Returns
    /// * `true` iff `line(from, to)` is `Some(M)` and every tile of `M` is walkable; a line that
    ///   leaves the board blocks the sight (D-27)
    /// # Panics
    /// * `'Asserter: position not inside'` if a position is outside the board
    ///
    /// Mirrors nothing in `hexx`: an extension (plan §6.6, N-5).
    fn line_of_sight(self: HexMap, from: u8, to: u8) -> bool {
        match self.line(from, to) {
            Some(mask) => {
                // [Compute] `M & ~grid == 0`, that is `M & grid == M`, limb by limb
                let mask: u256 = mask.into();
                let grid: u256 = self.grid.into();
                let (low, _, _) = Bits::bitwise(mask.low, grid.low);
                let (high, _, _) = Bits::bitwise(mask.high, grid.high);
                low == mask.low && high == mask.high
            },
            None => false,
        }
    }

    /// The side from which a target is approached along the line.
    /// # Arguments
    /// * `self` - The map
    /// * `from` - The position of origin
    /// * `to` - The target, ring tiles included
    /// # Returns
    /// * The direction, from `to`, of the tile of the line that precedes `to` (`from` itself when
    ///   the line has no tile between them); `None` when `from == to` or when the line leaves the
    ///   board
    /// # Panics
    /// * `'Asserter: position not inside'` if a position is outside the board
    ///
    /// Mirrors nothing in `hexx`: an extension (plan §6.6, N-5).
    fn approach(self: HexMap, from: u8, to: u8) -> Option<Direction> {
        let mask = self.line(from, to)?;
        if from == to {
            return None;
        }
        // [Compute] The tile before `to`: `from` when adjacent, else the one tile of the line
        // among the neighbours of `to` (`neighbor_mask` holds an interior tile only, the ring
        // takes the neighbours one direction at a time)
        let (width, height) = (self.width, self.height);
        let (y, x) = DivRem::div_rem(to, width.try_into().unwrap());
        let previous = if mask == 0 {
            Bits::pow(from)
        } else {
            let around = if x != 0 && y != 0 && x + 1 != width && y + 1 != height {
                let layout = LayoutTrait::new(width, height);
                layout.neighbor_mask(to)
            } else {
                LayoutTrait::edge_neighbors(width, height, to)
            };
            Bits::to_felt(Bits::and(mask.into(), around.into()))
        };
        // [Return] Its direction from `to`
        let (_, odd) = DivRem::div_rem(y, TWO);
        Some(LineInternal::direction(width, to, odd == 1, previous))
    }
}

/// The check of `line`.
#[generate_trait]
impl LineAssert of LineAssertTrait {
    /// Both positions lie in the board, `position < W * H`, for any `u8` dimensions (bounded
    /// integers, the facade's `is_inside`).
    #[feature("bounded-int-utils")]
    #[inline(always)]
    fn assert_inside(width: u8, height: u8, from: u8, to: u8) {
        // [Check] `position − W * H < 0`: the low side of the sign
        let size = mul::<_, _, SizeMul>(width, height);
        let from_inside =
            match constrain::<_, 0, PositionConstrain>(sub::<_, _, PositionSub>(from, size)) {
            Ok(_) => true,
            Err(_) => false,
        };
        let to_inside =
            match constrain::<_, 0, PositionConstrain>(sub::<_, _, PositionSub>(to, size)) {
            Ok(_) => true,
            Err(_) => false,
        };
        assert(from_inside && to_inside, errors::ASSERTER_POSITION_NOT_INSIDE);
    }
}

#[generate_trait]
impl LineInternal of LineInternalTrait {
    /// The table path, on the width 15.
    /// # Arguments
    /// * `from` - The first position, inside the board
    /// * `to` - The second position, inside the board
    /// # Returns
    /// * `Some(line)` when the distance is at most 6, `None` when the loop path must serve the
    ///   pair
    #[inline(always)]
    fn table(from: u8, to: u8) -> Option<Option<felt252>> {
        // [Compute] The key: the difference of the positions and the parity of the row of `from`
        let (_, column) = DivRem::div_rem(from, THIRTY);
        let parity = if column < TABLE_WIDTH {
            0
        } else {
            SPAN
        };
        let key: u32 = (to.into() + OFFSET + parity - from.into()).try_into()?;
        let (relative, lo, hi, lo_to, hi_to) = *LINES.span().get(key)?.unbox();
        // [Return] Every tile in the columns: the mask moved to `from`
        if lo <= column && column <= hi {
            return Some(Some(relative * Bits::pow(from)));
        }
        // [Return] The target in the columns but the line not: the line leaves the board;
        // otherwise the difference is that of a longer line on another row
        if lo_to <= column && column <= hi_to {
            return Some(None);
        }
        None
    }

    /// The loop path: the accumulators of `HexTrait::line_to` on the `Hex` of both positions,
    /// each step a move in one of at most three directions, walked on the board.
    /// # Arguments
    /// * `width` - The width of the map
    /// * `from` - The first position, inside the board
    /// * `to` - The second position, inside the board
    /// # Returns
    /// * The line, `None` as soon as a tile leaves the board (its rows lie between those of the
    ///   ends: only a column can leave)
    fn walk(width: u8, from: u8, to: u8) -> Option<felt252> {
        // [Compute] The ends: `Hex { x: −x − ⌈y/2⌉, y }`
        let divisor: NonZero<u8> = width.try_into().unwrap();
        let (y_from, x_from) = DivRem::div_rem(from, divisor);
        let (y_to, x_to) = DivRem::div_rem(to, divisor);
        let (half_from, odd_from) = DivRem::div_rem(y_from, TWO);
        let (half_to, odd_to) = DivRem::div_rem(y_to, TWO);
        let start: u16 = x_from.into() + half_from.into() + odd_from.into();
        let end: u16 = x_to.into() + half_to.into() + odd_to.into();
        // [Compute] `dx = start − end` is the move of the `Hex`'s `x`, `dy = y_to − y_from`
        let (east, mx) = if start > end {
            (true, start - end)
        } else {
            (false, end - start)
        };
        let (north, my): (bool, u16) = if y_to > y_from {
            (true, (y_to - y_from).into())
        } else {
            (false, (y_from - y_to).into())
        };
        // [Compute] The distance and the three moves: `x` alone, `y` alone, both
        let n = if east == north {
            mx + my
        } else if mx > my {
            mx
        } else {
            my
        };
        let (horizontal, vertical) = (
            if east {
                Direction::East
            } else {
                Direction::West
            },
            if north {
                Direction::NorthEast
            } else {
                Direction::SouthWest
            },
        );
        let both = if east {
            Direction::SouthEast
        } else {
            Direction::NorthWest
        };
        // [Compute] The accumulators of `line_to`: `x` ties toward the larger `x`, `y` toward
        // the smaller `y` (a tie rounds a magnitude down when its start is `N − 1`)
        let (mut ex, mut ey) = (
            if east || n == 0 {
                n
            } else {
                n - 1
            }, if north {
                n - 1
            } else {
                n
            },
        );
        let (ix, iy) = (2 * mx, 2 * my);
        let (tx, ty) = (2 * n - ix, 2 * n - iy);
        // [Compute] The tiles between the ends
        let up = Bits::pow(width);
        let down = Bits::inv(width);
        let shifts = Shifts {
            last: width - 1,
            up_narrow: up * INV_2,
            up,
            up_wide: up + up,
            down_narrow: down + down,
            down,
            down_wide: down * INV_2,
        };
        let mut cursor = Cursor { bit: Bits::pow(from), column: x_from, odd: odd_from == 1 };
        let mut mask: felt252 = 0;
        let mut step: u16 = 1;
        while step < n {
            let moved_x = if ex >= tx {
                ex -= tx;
                true
            } else {
                ex += ix;
                false
            };
            let moved_y = if ey >= ty {
                ey -= ty;
                true
            } else {
                ey += iy;
                false
            };
            let direction = if !moved_y {
                horizontal
            } else if moved_x {
                both
            } else {
                vertical
            };
            if !cursor.advance(@shifts, direction) {
                return None;
            }
            mask += cursor.bit;
            step += 1;
        }
        Some(mask)
    }

    /// The direction from `to` of its neighbour `previous`.
    /// # Arguments
    /// * `width` - The width of the map
    /// * `to` - The position
    /// * `odd` - Whether its row is odd
    /// * `previous` - The bit of one of its board neighbours
    /// # Returns
    /// * The direction, by the offsets of `types::direction`
    fn direction(width: u8, to: u8, odd: bool, previous: felt252) -> Direction {
        let power = Bits::pow(to);
        if previous == power * INV_2 {
            return Direction::East;
        }
        if previous == power + power {
            return Direction::West;
        }
        let up = power * Bits::pow(width);
        let down = power * Bits::inv(width);
        if odd {
            // NorthEast `+W`, NorthWest `+W+1`, SouthWest `−W+1`, SouthEast `−W`
            if previous == up {
                Direction::NorthEast
            } else if previous == up + up {
                Direction::NorthWest
            } else if previous == down + down {
                Direction::SouthWest
            } else {
                Direction::SouthEast
            }
        } else {
            // NorthEast `+W−1`, NorthWest `+W`, SouthWest `−W`, SouthEast `−W−1`
            if previous == up * INV_2 {
                Direction::NorthEast
            } else if previous == up {
                Direction::NorthWest
            } else if previous == down {
                Direction::SouthWest
            } else {
                Direction::SouthEast
            }
        }
    }
}

#[generate_trait]
impl CursorImpl of CursorTrait {
    /// Moves one tile in a direction (the offsets of `types::direction`).
    /// # Arguments
    /// * `self` - The cursor
    /// * `shifts` - The constants of the board
    /// * `direction` - The direction
    /// # Returns
    /// * `false` when the tile lies outside the columns of the board
    #[inline(always)]
    fn advance(ref self: Cursor, shifts: @Shifts, direction: Direction) -> bool {
        let shifts = *shifts;
        match direction {
            Direction::East => {
                if self.column == 0 {
                    return false;
                }
                self.column -= 1;
                self.bit *= INV_2;
            },
            Direction::West => {
                if self.column == shifts.last {
                    return false;
                }
                self.column += 1;
                self.bit += self.bit;
            },
            Direction::NorthEast => {
                if self.odd {
                    self.bit *= shifts.up;
                } else {
                    if self.column == 0 {
                        return false;
                    }
                    self.column -= 1;
                    self.bit *= shifts.up_narrow;
                }
                self.odd = !self.odd;
            },
            Direction::NorthWest => {
                if self.odd {
                    if self.column == shifts.last {
                        return false;
                    }
                    self.column += 1;
                    self.bit *= shifts.up_wide;
                } else {
                    self.bit *= shifts.up;
                }
                self.odd = !self.odd;
            },
            Direction::SouthWest => {
                if self.odd {
                    if self.column == shifts.last {
                        return false;
                    }
                    self.column += 1;
                    self.bit *= shifts.down_narrow;
                } else {
                    self.bit *= shifts.down;
                }
                self.odd = !self.odd;
            },
            Direction::SouthEast => {
                if self.odd {
                    self.bit *= shifts.down;
                } else {
                    if self.column == 0 {
                        return false;
                    }
                    self.column -= 1;
                    self.bit *= shifts.down_wide;
                }
                self.odd = !self.odd;
            },
        }
        true
    }
}

#[cfg(test)]
mod tests {
    // Local imports

    use hexx::board::bits::Bits;
    use hexx::board::direction::Direction;
    use hexx::board::geometry::Geometry;
    use hexx::board::layout::LayoutTrait;
    use hexx::board::map::HexMap;
    use hexx::hex::{Hex, HexTrait};
    use super::{LineInternal, LineTrait};

    /// Every tile of 15 × 16 walkable: 2^240 − 1.
    const OPEN_15X16: felt252 = 0xffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff;
    /// The window of the game.
    const WIDTH: u8 = 15;
    const HEIGHT: u8 = 16;
    /// The six directions, in index order.
    const DIRECTIONS: [Direction; 6] = [
        Direction::East, Direction::NorthEast, Direction::NorthWest, Direction::West,
        Direction::SouthWest, Direction::SouthEast,
    ];

    // Oracles

    #[generate_trait]
    impl Oracle of OracleTrait {
        /// The board's `line` by its definition (plan §6.6): the mirror's `line_to` between the
        /// `Hex` of both positions, each tile between the ends back on the board, `None` as soon
        /// as one leaves it.
        fn line(width: u8, height: u8, from: u8, to: u8) -> Option<felt252> {
            let line = Geometry::index_to_hex(width, from)
                .line_to(Geometry::index_to_hex(width, to));
            let mut mask: felt252 = 0;
            let mut i: u32 = 1;
            while i + 1 < line.len() {
                let position = Geometry::hex_to_index(width, height, *line.at(i))?;
                mask += Bits::pow(position);
                i += 1;
            }
            Some(mask)
        }

        /// `line_of_sight` by a per-tile scalar walk: every tile between the ends, a tile off the
        /// board blocks, a wall blocks.
        fn sight(width: u8, height: u8, grid: felt252, from: u8, to: u8) -> bool {
            let line = Geometry::index_to_hex(width, from)
                .line_to(Geometry::index_to_hex(width, to));
            let grid: u256 = grid.into();
            let mut i: u32 = 1;
            while i + 1 < line.len() {
                match Geometry::hex_to_index(width, height, *line.at(i)) {
                    Some(position) => { if !Bits::get(grid, position) {
                        return false;
                    } },
                    None => { return false; },
                }
                i += 1;
            }
            true
        }

        /// `approach` by the last ordered sample of the scalar line: the direction from `to` of
        /// the element that precedes it, `None` when `from == to` or the line leaves the board.
        fn approach(width: u8, height: u8, from: u8, to: u8) -> Option<Direction> {
            if from == to {
                return None;
            }
            Self::line(width, height, from, to)?;
            let line = Geometry::index_to_hex(width, from)
                .line_to(Geometry::index_to_hex(width, to));
            let previous = *line.at(line.len() - 2);
            let previous = Geometry::hex_to_index(width, height, previous).unwrap();
            LayoutTrait::neighbor_direction(width, height, to, previous)
        }

        /// Whether a position lies on the ring of the board.
        fn ring(width: u8, height: u8, position: u8) -> bool {
            let (x, y) = LayoutTrait::coords(width, position);
            x == 0 || y == 0 || x == width - 1 || y == height - 1
        }

        /// The next state of a 64-bit linear congruential generator (Knuth's MMIX constants).
        fn next(state: u64) -> u64 {
            let product: u128 = state.into() * 6364136223846793005 + 1442695040888963407;
            (product % 0x10000000000000000).try_into().unwrap()
        }

        /// A position of a board of `size` tiles drawn from a state.
        fn draw(state: u64, shift: u64, size: u16) -> u8 {
            let size: u64 = size.into();
            ((state / shift) % size).try_into().unwrap()
        }

        /// A map with no seed.
        fn map(width: u8, height: u8, grid: felt252) -> HexMap {
            HexMap { width, height, grid, seed: 0 }
        }

        /// The position of the tile `(x, y)`.
        fn at(width: u8, x: u8, y: u8) -> u8 {
            LayoutTrait::index(width, x, y)
        }
    }

    // Regression cases (plan §6.6)

    /// R-N5-1: on a 7 × 7, the tied midpoint of `(0, 0) → (0, 2)` is `(−1, 1)`, off the board.
    #[test]
    #[available_gas(l2_gas: 76671)]
    fn test_line_regression_r_n5_1() {
        let map = Oracle::map(7, 7, LayoutTrait::interior(7, 7));
        let (from, to) = (Oracle::at(7, 0, 0), Oracle::at(7, 0, 2));
        assert!(map.line(from, to).is_none());
        assert!(map.line(to, from).is_none());
        assert!(!map.line_of_sight(from, to));
        assert!(map.approach(from, to).is_none());
    }

    /// R-N5-2: on a 7 × 7, `(3, 3) → (3, 5)` has the single tile `(3, 4)`, index 31 (not 39).
    #[test]
    #[available_gas(l2_gas: 29873)]
    fn test_line_regression_r_n5_2() {
        let map = Oracle::map(7, 7, 0);
        let (from, to) = (Oracle::at(7, 3, 3), Oracle::at(7, 3, 5));
        assert!(map.line(from, to) == Some(0x80000000));
        assert!(map.line(to, from) == Some(0x80000000));
    }

    /// R-N5-3: on 15 × 16, `(0, 0) → (14, 15)` has 21 tiles between its ends and
    /// `(1, 14) → (13, 1)` has 18.
    #[test]
    #[available_gas(l2_gas: 340616)]
    fn test_line_regression_r_n5_3() {
        let map = Oracle::map(WIDTH, HEIGHT, 0);
        let line: u256 = map
            .line(Oracle::at(WIDTH, 0, 0), Oracle::at(WIDTH, 14, 15))
            .unwrap()
            .into();
        assert!(Bits::popcount(line) == 21);
        let line: u256 = map
            .line(Oracle::at(WIDTH, 1, 14), Oracle::at(WIDTH, 13, 1))
            .unwrap()
            .into();
        assert!(Bits::popcount(line) == 18);
    }

    /// R-N5-4: on 15 × 16, the predecessor of the ring target `(10, 15)` from `(7, 9)` is
    /// `(10, 14)`, its `SouthEast` neighbour (`i − W` on the odd row 15).
    #[test]
    #[available_gas(l2_gas: 100421)]
    fn test_line_regression_r_n5_4() {
        let map = Oracle::map(WIDTH, HEIGHT, 0);
        let (from, to) = (Oracle::at(WIDTH, 7, 9), Oracle::at(WIDTH, 10, 15));
        assert!(map.approach(from, to) == Some(Direction::SouthEast));
        let line: u256 = map.line(from, to).unwrap().into();
        assert!(Bits::get(line, Oracle::at(WIDTH, 10, 14)));
    }

    /// The ends: a tile with itself and two neighbours have nothing between them; `approach` is
    /// `None` on a tile with itself, and the direction of `from` seen from `to` on neighbours.
    #[test]
    #[available_gas(l2_gas: 273243183)]
    fn test_line_ends() {
        let boards: [(u8, u8); 3] = [(7, 7), (15, 16), (17, 14)];
        for (width, height) in boards.span() {
            let (width, height) = (*width, *height);
            let map = Oracle::map(width, height, 0);
            let mut from: u8 = 0;
            while from != width * height {
                assert!(map.line(from, from) == Some(0));
                assert!(map.approach(from, from).is_none());
                assert!(map.line_of_sight(from, from));
                for direction in DIRECTIONS.span() {
                    if let Some(to) = LayoutTrait::neighbor(width, height, from, *direction) {
                        assert!(map.line(from, to) == Some(0));
                        let back = LayoutTrait::neighbor_direction(width, height, to, from);
                        assert!(map.approach(from, to) == back);
                    }
                }
                from += 1;
            }
        }
    }

    /// A position outside the board panics, on either end, in each function.
    #[test]
    #[available_gas(l2_gas: 8201)]
    #[should_panic(expected: 'Asserter: position not inside')]
    fn test_line_revert_from_outside() {
        Oracle::map(WIDTH, HEIGHT, 0).line(240, 0);
    }

    #[test]
    #[available_gas(l2_gas: 8201)]
    #[should_panic(expected: 'Asserter: position not inside')]
    fn test_line_revert_to_outside() {
        Oracle::map(7, 7, 0).line(0, 49);
    }

    #[test]
    #[available_gas(l2_gas: 8201)]
    #[should_panic(expected: 'Asserter: position not inside')]
    fn test_line_of_sight_revert_outside() {
        Oracle::map(WIDTH, HEIGHT, 0).line_of_sight(0, 255);
    }

    #[test]
    #[available_gas(l2_gas: 8201)]
    #[should_panic(expected: 'Asserter: position not inside')]
    fn test_line_approach_revert_outside() {
        Oracle::map(WIDTH, HEIGHT, 0).approach(250, 0);
    }

    // The table against the loop: every pair within distance 6 of 15 × 16, from every position
    // (both parities); beyond it, the table serves nothing

    #[generate_trait]
    impl Check of CheckTrait {
        fn table(first: u8, last: u8) {
            let mut from = first;
            while from != last {
                let mut to: u8 = 0;
                while to != 240 {
                    let table = LineInternal::table(from, to);
                    if Geometry::distance(WIDTH, from, to) <= 6 {
                        let walk = LineInternal::walk(WIDTH, from, to);
                        assert!(table == Some(walk), "{} {}", from, to);
                    } else {
                        assert!(table.is_none(), "{} {}", from, to);
                    }
                    to += 1;
                }
                from += 1;
            }
        }

        /// `line(a, b) == line(b, a)` on every ordered pair from `first..last`, `None` included.
        fn symmetry(width: u8, height: u8, first: u8, last: u8) {
            let map = Oracle::map(width, height, 0);
            let size = width * height;
            let mut from = first;
            while from != last {
                let mut to = from + 1;
                while to != size {
                    assert!(map.line(from, to) == map.line(to, from), "{} {}", from, to);
                    to += 1;
                }
                from += 1;
            }
        }

        /// `approach` against the oracle, every `from` of 15 × 16 and the ring targets of rank
        /// `first..last` (the 58 ring tiles in index order).
        fn approach(first: u8, last: u8) {
            let map = Oracle::map(WIDTH, HEIGHT, 0);
            let mut rank: u8 = 0;
            let mut to: u8 = 0;
            while to != 240 {
                if Oracle::ring(WIDTH, HEIGHT, to) {
                    if first <= rank && rank < last {
                        let mut from: u8 = 0;
                        while from != 240 {
                            let expected = Oracle::approach(WIDTH, HEIGHT, from, to);
                            assert!(map.approach(from, to) == expected, "{} {}", from, to);
                            from += 1;
                        }
                    }
                    rank += 1;
                }
                to += 1;
            }
        }

        /// `line_of_sight` against the scalar walk on every ordered pair of 7 × 7.
        fn sight_7x7(grid: felt252) {
            let map = Oracle::map(7, 7, grid);
            let mut from: u8 = 0;
            while from != 49 {
                let mut to: u8 = 0;
                while to != 49 {
                    let expected = Oracle::sight(7, 7, grid, from, to);
                    assert!(map.line_of_sight(from, to) == expected, "{} {}", from, to);
                    to += 1;
                }
                from += 1;
            }
        }
    }

