    // Benchmarks, on the worst cases of plan §6.6: the difference between a test that calls twice
    // and one that calls once, the method of `bench_assembly`.

    #[derive(Copy, Drop)]
    struct Bench {
        /// The table case: from `(7, 7)` to `(3, 10)` (`Δ = (3, 3)` in the mirror frame, distance
        /// 6, ties at the steps 1, 3 and 5), then to `(12, 4)` (`Δ = (−3, −3)`).
        table: [(u8, u8); 2],
        /// The longest line of 15 × 16, `(0, 0) → (14, 15)` (22 steps), both ways.
        board: [(u8, u8); 2],
        /// The longest line between interior tiles, `(1, 14) → (13, 1)` (19 steps), both ways.
        interior: [(u8, u8); 2],
        /// The diameter of 83 × 3, `(0, 0) → (82, 2)` (83 steps), both ways.
        wide: [(u8, u8); 2],
        /// Ring targets at distance 6: `(7, 9) → (10, 15)` (R-N5-4) and `(7, 6) → (4, 0)`.
        ring: [(u8, u8); 2],
        /// The mirror: `Δ = (11, 11)`, 22 steps with a tie at every odd step.
        hexes: [(Hex, Hex); 2],
    }

    #[generate_trait]
    impl Inputs of InputsTrait {
        /// The inputs, opaque to the compiler (`#[inline(never)]`, as in `bench_assembly`).
        #[inline(never)]
        fn get() -> Bench {
            Bench {
                table: [(112, 153), (112, 72)],
                board: [(0, 239), (239, 0)],
                interior: [(211, 28), (28, 211)],
                wide: [(0, 248), (248, 0)],
                ring: [(142, 235), (97, 4)],
                hexes: [
                    (Hex { x: 0, y: 0 }, Hex { x: 11, y: 11 }),
                    (Hex { x: 5, y: -3 }, Hex { x: 16, y: 8 }),
                ],
            }
        }
    }

