//! N-6, range and ring as geometry (plan §6.7): the tiles of a board within a radius of a tile,
//! and those at exactly that radius, walls ignored, clipped to the board with its ring: the sight
//! of radius 6 and the area of an effect around a target.
//!
//! Two paths give the same result. Radius 0 is the tile itself, before any dispatch. The **table
//! path** serves the width 15 and a radius of `1..=7`: the canonical shape of `HEXAGONS` (or
//! `HEXAGON_RINGS`), clipped to the board **before** it is moved to the position (a move first
//! would reduce the bits that leave the board modulo the field), then one product. The **loop
//! path** serves every other case: one iteration per row of the board the shape meets, at most
//! `H`, each adding the row's extent (plan §6.7, "Dispatch").
//!
//! Mirrors nothing in `hexx`: an extension (plan §6.7, N-6). `hexx`'s `Hex::range` and `Hex::ring`
//! are the same sets on an unbounded grid; `tools/refgen` checks the tables against them.

// Internal imports

use hexx::board::asserter::Asserter;
use hexx::board::bits::Bits;
use hexx::board::map::HexMap;
use hexx::board::tables::{COL_FROM, ROW_FROM_16};

// Constants

/// The width the table path serves, and the same as a divisor.
const TABLE_WIDTH: u8 = 15;
const FIFTEEN: NonZero<u8> = 15;
/// The largest radius of the table path: a hexagon of radius `r` spans `2r + 1` columns.
const TABLE_RADIUS: u8 = 7;
/// 2, as a divisor.
const TWO: NonZero<u8> = 2;
/// The largest radius the loop path computes with: every distance on a board of the engine is
/// below `W + H ≤ 86` (`W · H ≤ 251`, `W, H ≥ 3`), so a larger radius has the same tiles
/// (all of them in `hexagon`, none in `hexagon_ring`), and `2r` stays in the tables of `Bits`.
const LOOP_RADIUS: u8 = 100;

// region generated by `cargo run --manifest-path tools/refgen/Cargo.toml -- gen hexagon`:
// tables, do not edit

/// The canonical hexagons of the table path, key `7 · (row is odd) + radius − 1`, radius
/// `1..=7`: the tiles of the 15 × 16 board within `radius` of `(7, 8)` (index 127, even row)
/// or `(7, 7)` (index 112, odd row). Each lies whole in the board.
const HEXAGONS: [felt252; 14] = [
    0x6001c0018000000000000000000000000000, 0x7000f003e003c007000000000000000000000000,
    0x3c00f801f807f007e00f800f00000000000000000000,
    0x3e007e01fc03fc0ff80ff01fc01f803e0000000000000000,
    0x1f807f00ff03fe07fe1ffc1ff83fe03fc07f007e000000000000,
    0x1fc03fc0ff81ff87ff0fff3ffe3ffc7ff07fe0ff80ff01fc00000000,
    0xff03fe07fe1ffc3ffcfff9fffffff7ffefff8fff1ffc1ff83fe03fc0000,
    0x180038006000000000000000000000000, 0xe003c007c00f000e00000000000000000000,
    0xf001f007e00fe01f801f003c0000000000000000, 0x7c01f803f80ff01ff03fc03f807e007c000000000000,
    0x7e00fe03fc07fc1ff83ff87fe07fc0ff00fe01f800000000,
    0x3f80ff01ff07fe0ffe3ffc7ffcfff0ffe1ff81ff03fc03f80000,
    0x3fc07fc1ff83ff8fff1fff7ffefffffff9fff3ffc3ff87fe07fc0ff0,
];
/// The canonical rings of the table path, the same keys: the tiles at exactly `radius`.
const HEXAGON_RINGS: [felt252; 14] = [
    0x600140018000000000000000000000000000, 0x7000900220024007000000000000000000000000,
    0x3c008801080410042008800f00000000000000000000,
    0x3e00420104020408080810104010803e0000000000000000,
    0x1f8041008102020402100410082020204041007e000000000000,
    0x1fc0204080810084010801200220044010402080808101fc00000000,
    0xff02020402100420048009000c001400280088011004100820203fc0000,
    0x180028006000000000000000000000000, 0xe00240044009000e00000000000000000000,
    0xf0011004200820108011003c0000000000000000, 0x7c01080208081010102040208042007c000000000000,
    0x7e008202040404100820084020404081008201f800000000,
    0x3f80810101040208022004400480108021008101020403f80000,
    0x3fc04041008200880110014002800300090012004200840204040ff0,
];

// endregion

/// A row of the loop path: the ends of the extent of the hexagon on it, the row, and its place in
/// the scan.
#[derive(Copy, Drop)]
struct Scan {
    /// `2^(row·W + lo)` and `2^(row·W + hi)`, the ends of the extent unclipped (an exponent below
    /// 0 is an inverse in the field, so that a move to the next row stays one exact product), and
    /// `2^(row·W)`.
    lo: felt252,
    hi: felt252,
    row: felt252,
    /// `|row − y|`, and whether the row lies above the centre.
    distance: felt252,
    above: bool,
    /// The parity of the row.
    odd: bool,
    /// Whether the extent leaves the row on the left (`lo < 0`) and on the right (`hi ≥ W`).
    left: bool,
    right: bool,
}

/// The constants of a scan.
#[derive(Copy, Drop)]
struct Bounds {
    /// `2^(W−1)`, `2^W`, `2^(W+1)`: the moves to the next row.
    narrow: felt252,
    width: felt252,
    wide: felt252,
    /// The extent leaves the row on the left when `|row − y| < left`, on the right when
    /// `|row − y| < right`: two bands about the row of the centre.
    left: felt252,
    right: felt252,
    /// `|row − y|` of the last row, below the centre.
    last: felt252,
}

#[generate_trait]
pub impl HexagonImpl of HexagonTrait {
    /// The tiles within a radius of a position, walls ignored.
    /// # Arguments
    /// * `self` - The map, any dimensions of the engine (`W, H >= 3`, `W * H <= 251`); they are
    ///   not checked: a map outside that domain is the caller's error, as in `LineTrait`
    /// * `position` - The centre, ring tiles included
    /// * `radius` - The radius, any
    /// # Returns
    /// * The bitmap of the tiles `t` of the board, ring included, with
    ///   `hex_distance(position, t) <= radius`; `2^position` for the radius 0
    /// # Panics
    /// * `'Asserter: position not inside'` if `position` is outside the board (`>= W * H`)
    ///
    /// Mirrors nothing in `hexx`: an extension (plan §6.7, N-6).
    fn hexagon(self: HexMap, position: u8, radius: u8) -> felt252 {
        // [Check] The position inside the board
        let (width, height) = (self.width, self.height);
        Asserter::assert_inside(width, height, position);
        // [Return] The radius 0, before any dispatch
        if radius == 0 {
            return Bits::pow(position);
        }
        // [Return] The table path: the width 15, a radius of at most 7
        if width == TABLE_WIDTH && radius <= TABLE_RADIUS {
            return HexagonInternal::table(HEXAGONS.span(), height, position, radius);
        }
        // [Return] The loop path
        HexagonInternal::rows(width, height, position, radius)
    }

    /// The tiles at exactly a radius of a position, walls ignored.
    /// # Arguments
    /// * `self` - The map, any dimensions of the engine (`W, H >= 3`, `W * H <= 251`); they are
    ///   not checked: a map outside that domain is the caller's error, as in `LineTrait`
    /// * `position` - The centre, ring tiles included
    /// * `radius` - The radius, any
    /// # Returns
    /// * The bitmap of the tiles `t` of the board, ring included, with
    ///   `hex_distance(position, t) == radius`, that is `hexagon(r) − hexagon(r − 1)`;
    ///   `2^position` for the radius 0
    /// # Panics
    /// * `'Asserter: position not inside'` if `position` is outside the board (`>= W * H`)
    ///
    /// Mirrors nothing in `hexx`: an extension (plan §6.7, N-6).
    fn hexagon_ring(self: HexMap, position: u8, radius: u8) -> felt252 {
        // [Check] The position inside the board
        let (width, height) = (self.width, self.height);
        Asserter::assert_inside(width, height, position);
        // [Return] The radius 0, before any dispatch
        if radius == 0 {
            return Bits::pow(position);
        }
        // [Return] The table path: the width 15, a radius of at most 7
        if width == TABLE_WIDTH && radius <= TABLE_RADIUS {
            return HexagonInternal::table(HEXAGON_RINGS.span(), height, position, radius);
        }
        // [Return] The loop path
        HexagonInternal::ring_rows(width, height, position, radius)
    }
}

#[generate_trait]
impl HexagonInternal of HexagonInternalTrait {
    /// The table path, on the width 15.
    /// # Arguments
    /// * `shapes` - `HEXAGONS` or `HEXAGON_RINGS`
    /// * `height` - The height of the map, at most 16
    /// * `position` - The centre, inside the board
    /// * `radius` - The radius, in `1..=7`
    /// # Returns
    /// * The canonical shape of the parity of the row, clipped to the board, then moved to
    ///   `position`
    #[inline(always)]
    fn table(shapes: Span<felt252>, height: u8, position: u8, radius: u8) -> felt252 {
        // [Compute] The canonical shape and its move: centre `(7, 8)`, index 127, on an even row,
        // `(7, 7)`, index 112, on an odd one; the row parity is kept by a move of whole row pairs
        let (y, x) = DivRem::div_rem(position, FIFTEEN);
        let (_, odd) = DivRem::div_rem(y, TWO);
        let shape = *shapes.at((TABLE_RADIUS * odd + radius - 1).into());
        let centre = 127 - TABLE_WIDTH * odd;
        let shift = if position >= centre {
            Bits::pow(position - centre)
        } else {
            Bits::inv(centre - position)
        };
        // [Return] The shape whole in the board: its columns are `x − r..=x + r`, its rows
        // `y − r..=y + r`
        if x >= radius && x + radius < TABLE_WIDTH && y >= radius && y + radius < height {
            return shape * shift;
        }
        // [Compute] The clip, in the canonical frame: the columns `[lo_c, hi_c)` and the rows
        // `[lo_r, hi_r)` that land in the board, with `lo_c = max(0, 7 − x)`,
        // `hi_c = min(15, 22 − x)`, `lo_r = max(0, y0 − y)`, `hi_r = min(16, y0 − y + H)`,
        // `y0`
        // the canonical row
        let row = 8 - odd;
        let lo_c = if x < 7 {
            7 - x
        } else {
            0
        };
        let hi_c = if x > 7 {
            22 - x
        } else {
            15
        };
        let lo_r = if y < row {
            row - y
        } else {
            0
        };
        let top = row + height - y;
        let hi_r = if top > 16 {
            16
        } else {
            top
        };
        // [Compute] The rectangle, the product of a column band and a row band (disjoint bits)
        let columns = *COL_FROM.span().at(lo_c.into()) - *COL_FROM.span().at(hi_c.into());
        let rows = *ROW_FROM_16.span().at(lo_r.into()) - *ROW_FROM_16.span().at(hi_r.into());
        let clipped = Bits::to_felt(Bits::and(shape.into(), (columns * rows).into()));
        // [Return] The move, exact: every bit left lands in the board, on its own row
        clipped * shift
    }

    /// The loop path of `hexagon`: each row of the board the hexagon meets adds its extent,
    /// clipped to the row.
    /// # Arguments
    /// * `width` - The width of the map
    /// * `height` - The height of the map
    /// * `position` - The centre, inside the board
    /// * `radius` - The radius, at least 1
    /// # Returns
    /// * The hexagon
    fn rows(width: u8, height: u8, position: u8, radius: u8) -> felt252 {
        let (mut scan, bounds, _) = ScanTrait::new(width, height, position, radius);
        let mut mask: felt252 = 0;
        loop {
            mask += scan.extent(@bounds);
            if !scan.above && scan.distance == bounds.last {
                break;
            }
            scan.step(@bounds);
        }
        mask
    }

    /// The loop path of `hexagon_ring`: on the rows at the distance `radius`, the whole extent;
    /// on every other row, its two ends (the extent of the radius `r − 1` is `lo + 1..=hi − 1`
    /// there), each when it lies in the row.
    /// # Arguments
    /// * `width` - The width of the map
    /// * `height` - The height of the map
    /// * `position` - The centre, inside the board
    /// * `radius` - The radius, at least 1
    /// # Returns
    /// * The ring
    fn ring_rows(width: u8, height: u8, position: u8, radius: u8) -> felt252 {
        let (mut scan, bounds, radius) = ScanTrait::new(width, height, position, radius);
        let mut mask: felt252 = 0;
        loop {
            if scan.distance == radius {
                mask += scan.extent(@bounds);
            } else {
                // [Compute] Both ends, distinct (the extent has at least `radius + 2` tiles)
                if !scan.left {
                    mask += scan.lo;
                }
                if !scan.right {
                    mask += scan.hi;
                }
            }
            if !scan.above && scan.distance == bounds.last {
                break;
            }
            scan.step(@bounds);
        }
        mask
    }
}

#[generate_trait]
impl ScanImpl of ScanTrait {
    /// The first row the hexagon meets and the constants of the scan.
    /// # Arguments
    /// * `width` - The width of the map
    /// * `height` - The height of the map
    /// * `position` - The centre `(x, y)`, inside the board
    /// * `radius` - The radius, at least 1
    /// # Returns
    /// * The scan on the row `max(0, y − r)`, its bounds (the last row is `min(H − 1, y + r)`),
    ///   and the radius the scan uses, `min(r, LOOP_RADIUS)`
    ///
    /// On the row at `k = |row − y|` the extent is `lo = x − r + A`, `hi = x + r − B` with
    /// `B = ⌈k/2⌉` and `A = ⌊k/2⌋` when `y` is even, the other way round when it is odd
    /// (odd-r offset, the same above and below the centre). It always holds the column `x`.
    /// So the extent leaves the row on the left iff `A < r − x`, that is
    /// `k < 2(r − x) − (y mod 2)`, and on the right iff `B < x + r + 1 − W`, that is
    /// `k < 2(x + r + 1 − W) − 1 + (y mod 2)`.
    #[inline(always)]
    fn new(width: u8, height: u8, position: u8, radius: u8) -> (Scan, Bounds, felt252) {
        let radius = if radius > LOOP_RADIUS {
            LOOP_RADIUS
        } else {
            radius
        };
        let (y, x) = DivRem::div_rem(position, width.try_into().unwrap());
        let (_, odd) = DivRem::div_rem(y, TWO);
        let top = if y > radius {
            radius
        } else {
            y
        };
        let below = height - 1 - y;
        let last = if radius < below {
            radius
        } else {
            below
        };
        // [Compute] The ends on the first row, `k = top`, as bit indices: `hi = first + r − B`,
        // `lo = hi − (2r − k)`
        let (shrink, _) = DivRem::div_rem(top + 1 - odd, TWO);
        let first = position - top * width;
        let hi = Bits::pow(first) * Bits::pow(radius - shrink);
        let lo = hi * Bits::inv(2 * radius - top);
        let row = Bits::pow(first - x);
        let (_, first_odd) = DivRem::div_rem(y - top, TWO);
        let narrow = Bits::pow(width - 1);
        // [Compute] The bands
        let (x, radius, width, odd): (u16, u16, u16, u16) = (
            x.into(), radius.into(), width.into(), odd.into(),
        );
        let left = if radius > x {
            2 * (radius - x) - odd
        } else {
            0
        };
        let span = x + radius + 1;
        let right = if span > width {
            2 * (span - width) - 1 + odd
        } else {
            0
        };
        // [Compute] The scan, its counters on `felt252` (equalities only, no range check)
        let distance: u16 = top.into();
        let scan = Scan {
            lo,
            hi,
            row,
            distance: distance.into(),
            above: top != 0,
            odd: first_odd == 1,
            left: distance < left,
            right: distance < right,
        };
        let bounds = Bounds {
            narrow,
            width: narrow + narrow,
            wide: 4 * narrow,
            left: left.into(),
            right: right.into(),
            last: last.into(),
        };
        (scan, bounds, radius.into())
    }

    /// The extent of the row, clipped to it.
    #[inline(always)]
    fn extent(self: @Scan, bounds: @Bounds) -> felt252 {
        let start = if *self.left {
            *self.row
        } else {
            *self.lo
        };
        let end = if *self.right {
            *self.row * *bounds.width
        } else {
            *self.hi + *self.hi
        };
        end - start
    }

    /// The next row: above the centre the extent grows by one tile, on the left from an even row
    /// and on the right from an odd one (odd-r offset); from the centre on it shrinks, on the right
    /// from an even row and on the left from an odd one. The clip of a side starts when `|row −
    /// y|`
    /// enters its band and ends when it leaves it.
    #[inline(always)]
    fn step(ref self: Scan, bounds: @Bounds) {
        let (narrow, width, wide) = (*bounds.narrow, *bounds.width, *bounds.wide);
        if self.above {
            if self.odd {
                self.lo *= width;
                self.hi *= wide;
            } else {
                self.lo *= narrow;
                self.hi *= width;
            }
            if self.distance == *bounds.left {
                self.left = true;
            }
            if self.distance == *bounds.right {
                self.right = true;
            }
            self.distance -= 1;
            self.above = self.distance != 0;
        } else {
            if self.odd {
                self.lo *= wide;
                self.hi *= width;
            } else {
                self.lo *= width;
                self.hi *= narrow;
            }
            self.distance += 1;
            if self.distance == *bounds.left {
                self.left = false;
            }
            if self.distance == *bounds.right {
                self.right = false;
            }
        }
        self.row *= width;
        self.odd = !self.odd;
    }
}

