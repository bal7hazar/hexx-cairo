    // Benchmarks, on the worst cases of plan §6.7: the difference between a test that calls twice
    // and one that calls once, the method of `bench_assembly`; the second call is the measured
    // case.

    #[derive(Copy, Drop)]
    struct Bench {
        /// The sight, table path: radius 6 from `(7, 7)`, then from `(7, 8)` (the tick's figure).
        sight: [(u8, u8); 2],
        /// The table path, maximal clipping: radius 7 from `(13, 1)`, then from `(1, 1)`.
        clip: [(u8, u8); 2],
        /// The loop path on 15 × 16 (16 rows): radius 9, then 8, from `(7, 8)`.
        board: [(u8, u8); 2],
        /// The loop path on 15 × 16 (16 rows): radius 8, then 9, from `(7, 8)`.
        board_wide: [(u8, u8); 2],
        /// The loop path on 3 × 83 (83 rows): radius 255 from `(1, 40)`, then from `(1, 41)`.
        tall: [(u8, u8); 2],
        /// The ring on 3 × 83 (83 rows): radius 41 from `(1, 40)`, then from `(1, 41)` (its first
        /// and last rows are the rows 0 and 82, whole; at the radius 255 the ring is empty).
        tall_ring: [(u8, u8); 2],
    }

    #[generate_trait]
    impl Inputs of InputsTrait {
        /// The inputs, opaque to the compiler (`#[inline(never)]`, as in `bench_assembly`).
        #[inline(never)]
        fn get() -> Bench {
            Bench {
                sight: [(112, 6), (127, 6)],
                clip: [(28, 7), (16, 7)],
                board: [(127, 9), (127, 8)],
                board_wide: [(127, 8), (127, 9)],
                tall: [(121, 255), (124, 255)],
                tall_ring: [(121, 41), (124, 41)],
            }
        }
    }

