        /// The per-position variant (plan §6.7, "Why not the flood"), not shipped: one lookup of
        /// `SIGHTS` after the same check of the position as `hexagon`.
        #[inline(always)]
        fn sight(map: HexMap, position: u8) -> felt252 {
            Asserter::assert_inside(map.width, map.height, position);
            *SIGHTS.span().at(position.into())
        }
    }

