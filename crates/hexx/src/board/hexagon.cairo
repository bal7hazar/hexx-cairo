    // The tables against the per-tile definition at their canonical centres

    #[test]
    #[available_gas(l2_gas: 7792491)]
    fn test_hexagon_tables() {
        let map = Oracle::map(WIDTH, HEIGHT);
        let mut odd: u32 = 0;
        while odd != 2 {
            let centre: u8 = if odd == 0 {
                127
            } else {
                112
            };
            let mut rings = Oracle::rings(map, centre);
            let mut radius: u8 = 1;
            while radius != 8 {
                let key = 7 * odd + radius.into() - 1;
                assert!(*HEXAGONS.span().at(key) == Oracle::hexagon(ref rings, radius));
                assert!(*HEXAGON_RINGS.span().at(key) == rings.get(radius.into()));
                radius += 1;
            }
            odd += 1;
        }
    }

