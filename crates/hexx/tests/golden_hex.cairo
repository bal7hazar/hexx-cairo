#[test]
#[available_gas(l2_gas: 58643)]
fn golden_hex_constants_l_m2() {
    assert(HexTrait::ORIGIN == HexTrait::new(0, 0), 'ORIGIN');
    assert(HexTrait::ONE == HexTrait::new(1, 1), 'ONE');
    assert(HexTrait::NEG_ONE == HexTrait::new(-1, -1), 'NEG_ONE');
    assert(HexTrait::X == HexTrait::new(1, 0), 'X');
    assert(HexTrait::NEG_X == HexTrait::new(-1, 0), 'NEG_X');
    assert(HexTrait::Y == HexTrait::new(0, 1), 'Y');
    assert(HexTrait::NEG_Y == HexTrait::new(0, -1), 'NEG_Y');
    let incr_x = HexTrait::INCR_X;
    let incr_x = incr_x.span();
    assert(incr_x.len() == 2, 'INCR_X len');
    assert(*incr_x.at(0) == HexTrait::new(1, 0), 'INCR_X 0');
    assert(*incr_x.at(1) == HexTrait::new(1, -1), 'INCR_X 1');
    let incr_y = HexTrait::INCR_Y;
    let incr_y = incr_y.span();
    assert(incr_y.len() == 2, 'INCR_Y len');
    assert(*incr_y.at(0) == HexTrait::new(0, 1), 'INCR_Y 0');
    assert(*incr_y.at(1) == HexTrait::new(-1, 1), 'INCR_Y 1');
    let incr_z = HexTrait::INCR_Z;
    let incr_z = incr_z.span();
    assert(incr_z.len() == 2, 'INCR_Z len');
    assert(*incr_z.at(0) == HexTrait::new(-1, 0), 'INCR_Z 0');
    assert(*incr_z.at(1) == HexTrait::new(0, -1), 'INCR_Z 1');
    let decr_x = HexTrait::DECR_X;
    let decr_x = decr_x.span();
    assert(decr_x.len() == 2, 'DECR_X len');
    assert(*decr_x.at(0) == HexTrait::new(-1, 0), 'DECR_X 0');
    assert(*decr_x.at(1) == HexTrait::new(-1, 1), 'DECR_X 1');
    let decr_y = HexTrait::DECR_Y;
    let decr_y = decr_y.span();
    assert(decr_y.len() == 2, 'DECR_Y len');
    assert(*decr_y.at(0) == HexTrait::new(0, -1), 'DECR_Y 0');
    assert(*decr_y.at(1) == HexTrait::new(1, -1), 'DECR_Y 1');
    let decr_z = HexTrait::DECR_Z;
    let decr_z = decr_z.span();
    assert(decr_z.len() == 2, 'DECR_Z len');
    assert(*decr_z.at(0) == HexTrait::new(1, 0), 'DECR_Z 0');
    assert(*decr_z.at(1) == HexTrait::new(0, 1), 'DECR_Z 1');
    let diagonal_coords = HexTrait::DIAGONAL_COORDS;
    let diagonal_coords = diagonal_coords.span();
    assert(diagonal_coords.len() == 6, 'DIAGONAL_COORDS len');
    assert(*diagonal_coords.at(0) == HexTrait::new(2, -1), 'DIAGONAL_COORDS 0');
    assert(*diagonal_coords.at(1) == HexTrait::new(1, 1), 'DIAGONAL_COORDS 1');
    assert(*diagonal_coords.at(2) == HexTrait::new(-1, 2), 'DIAGONAL_COORDS 2');
    assert(*diagonal_coords.at(3) == HexTrait::new(-2, 1), 'DIAGONAL_COORDS 3');
    assert(*diagonal_coords.at(4) == HexTrait::new(-1, -1), 'DIAGONAL_COORDS 4');
