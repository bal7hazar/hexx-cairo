        (46340, 0, 40000, -40000, 1893795600), (46340, 0, 46340, -46340, 2147395600),
        (46340, 0, 32768, -32768, 1702668304), (46340, 0, 32767, -32768, 1702728217),
        (46340, 0, 46340, 0, 0), (46340, 0, 46341, 0, 1), (46341, 0, 1, 0, 2147395600),
        (46341, 0, 40000, -40000, 1893848281), (46341, 0, 46340, -46340, 2147441941),
        (46341, 0, 32768, -32768, 1702728217), (46341, 0, 32767, -32768, 1702788132),
        (46341, 0, 46340, 0, 1), (46341, 0, 46341, 0, 0), (0, -46341, 0, -1, 2147395600),
        (0, -46341, 40000, -40000, 1893848281), (0, -46341, 46340, -46340, 2147441941),
        (0, -46341, 32768, -32768, 1702728217), (0, -46341, 32767, -32768, 1702649109),
        (0, -46341, 0, -46341, 0),
    ];
    let mut i = 0;
    while i < cases.len() {
        let (x1, y1, x2, y2, e) = *cases.at(i);
        let a = HexTrait::new(x1, y1);
        let b = HexTrait::new(x2, y2);
        assert(a.squared_euclidean_distance_to(b) == e, 'squared_euclidean_distance_to');
        i += 1;
    }
}

