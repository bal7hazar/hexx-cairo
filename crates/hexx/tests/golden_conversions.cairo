#[test]
#[available_gas(l2_gas: 291984)]
fn golden_conversions_bounds_from_hexmod() {
    let cases: Array<(u32, u32, i32, i32)> = array![
        (0, 1, 0, 0), (0, 6, 0, 0), (1, 1, 0, 1), (1, 6, 0, 1),
        (2147483634, 1, 322122545, -214748365), (2147483634, 6, 73466544, -39558917),
        (2147483635, 1, 322122545, -214748364), (2147483635, 6, 73466544, -39558916),
        (2147483645, 1, 322122547, -214748364),
    ];
    let mut i = 0;
    while i < cases.len() {
        let (c, r, ex, ey) = *cases.at(i);
        let h = HexConversionsTrait::from_hexmod_coordinates(c, r);
        assert(h == HexTrait::new(ex, ey), 'from_hexmod');
        i += 1;
    }
}

